<?xml version="1.0" encoding="utf-8"?>
<SMIRNOFF version="0.3" aromaticity_model="OEAroModel_MDL">
  <vdW version="0.4" potential="Lennard-Jones-12-6" combining_rules="Lorentz-Berthelot" scale12="0.0" scale13="0.0" scale14="0.5" scale15="1.0" cutoff="9.0 * angstrom ** 1" switch_width="1.0 * angstrom ** 1" periodic_method="cutoff" nonperiodic_method="no-cutoff">
    <Atom smirks="[#5X4-1:1]" id="lidfob-borate-b" epsilon="0.095 * mole ** -1 * kilocalorie ** 1" rmin_half="1.92 * angstrom ** 1"/>
  </vdW>
  <Bonds version="0.4" potential="harmonic" fractional_bondorder_method="AM1-Wiberg" fractional_bondorder_interpolation="linear">
    <Bond smirks="[#5X4-1:1]-[#9X1:2]" id="lidfob-bf" length="1.39 * angstrom" k="450.0 * kilocalorie_per_mole/angstrom**2"/>
    <Bond smirks="[#5X4-1:1]-[#8X2:2]" id="lidfob-bo" length="1.48 * angstrom" k="430.0 * kilocalorie_per_mole/angstrom**2"/>
  </Bonds>
  <Angles version="0.3" potential="harmonic">
    <Angle smirks="[#9X1:1]-[#5X4-1:2]-[#9X1:3]" id="lidfob-fbf" angle="109.5 * degree" k="90.0 * kilocalorie_per_mole/radian**2"/>
    <Angle smirks="[#9X1:1]-[#5X4-1:2]-[#8X2:3]" id="lidfob-fbo" angle="109.5 * degree" k="95.0 * kilocalorie_per_mole/radian**2"/>
    <Angle smirks="[#8X2:1]-[#5X4-1:2]-[#8X2:3]" id="lidfob-obo" angle="109.5 * degree" k="100.0 * kilocalorie_per_mole/radian**2"/>
    <Angle smirks="[#5X4-1:1]-[#8X2:2]-[#6X3:3]" id="lidfob-boc" angle="120.0 * degree" k="110.0 * kilocalorie_per_mole/radian**2"/>
  </Angles>
  <ProperTorsions version="0.4" potential="k*(1+cos(periodicity*theta-phase))" default_idivf="auto">
    <Proper smirks="[#9X1:1]-[#5X4-1:2]-[#8X2:3]-[#6X3:4]" id="lidfob-fboc" periodicity1="3" phase1="0.0 * degree" k1="0.20 * kilocalorie_per_mole"/>
    <Proper smirks="[#8X2:1]-[#5X4-1:2]-[#8X2:3]-[#6X3:4]" id="lidfob-oboc" periodicity1="3" phase1="0.0 * degree" k1="0.20 * kilocalorie_per_mole"/>
    <Proper smirks="[#5X4-1:1]-[#8X2:2]-[#6X3:3]-[#6X3:4]" id="lidfob-bocc" periodicity1="2" phase1="180.0 * degree" k1="1.00 * kilocalorie_per_mole"/>
    <Proper smirks="[#5X4-1:1]-[#8X2:2]-[#6X3:3]-[#8X1:4]" id="lidfob-boco" periodicity1="2" phase1="180.0 * degree" k1="1.00 * kilocalorie_per_mole"/>
  </ProperTorsions>
</SMIRNOFF>
