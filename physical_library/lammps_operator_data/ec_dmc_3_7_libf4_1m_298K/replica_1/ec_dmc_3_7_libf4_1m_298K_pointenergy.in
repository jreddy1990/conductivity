units real
atom_style full

dimension 3
boundary p p p

bond_style harmonic
angle_style harmonic
dihedral_style fourier
improper_style cvff
special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333 
pair_style lj/cut/coul/long 9.0 9.0
pair_modify mix arithmetic tail yes

read_data /Users/jreddy/electrolyte_formation_sim/conductivity/physical_library/lammps_operator_data/ec_dmc_3_7_libf4_1m_298K/replica_1/ec_dmc_3_7_libf4_1m_298K.lmp

thermo_style custom ebond eangle edihed eimp epair evdwl ecoul elong etail pe

fix 100 all shake 0.0001 20 10 b 3
kspace_style pppm 1e-4
run 0
