# Stationarity-gated NVE production for composition tag=ec_dmc_3_7_libf4_1m_298K
# Generated by scripts/curate_ff_md_data.py

read_restart    ${equilibrated_restart}
kspace_style    pppm 1.0e-4

# Species are grouped by molecule-id range, not by atom type. Sage SMIRKS
# assigns the same atom type to chemically equivalent atoms across different
# molecules (e.g. carbonyl O in EC and sulfonyl O in FSI-), so atom-type
# grouping would conflate FSI- O with EC O. pack_box orders molecules by the
# sequence we pass to it; openff-interchange writes 1-based sequential
# molecule ids matching that order. We use the built-in `all` group rather
# than redefining an ATOMS group because the non-polarizable Sage topology
# has no Drude particles to exclude.
group           LIGROUP    molecule 87:93
group           ANIONGROUP molecule 94:100
group           NEUTRALGROUP molecule 1:30 31:86

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        1.0

velocity        all zero linear
write_data      ec_dmc_3_7_libf4_1m_298K.eq.lmp

fix             NVE_PROD all nve

variable        jx atom q*vx
variable        jy atom q*vy
variable        jz atom q*vz
compute         JX_LI  LIGROUP    reduce sum v_jx
compute         JY_LI  LIGROUP    reduce sum v_jy
compute         JZ_LI  LIGROUP    reduce sum v_jz
compute         JX_AN  ANIONGROUP reduce sum v_jx
compute         JY_AN  ANIONGROUP reduce sum v_jy
compute         JZ_AN  ANIONGROUP reduce sum v_jz
compute         JX_NEUT NEUTRALGROUP reduce sum v_jx
compute         JY_NEUT NEUTRALGROUP reduce sum v_jy
compute         JZ_NEUT NEUTRALGROUP reduce sum v_jz
compute         JX_ALL all reduce sum v_jx
compute         JY_ALL all reduce sum v_jy
compute         JZ_ALL all reduce sum v_jz

fix             CURRENT all ave/time 1 1 1 c_JX_ALL c_JY_ALL c_JZ_ALL c_JX_LI c_JY_LI c_JZ_LI c_JX_AN c_JY_AN c_JZ_AN c_JX_NEUT c_JY_NEUT c_JZ_NEUT file current.dat format " %.10e"
# Primitive response observables for atmosphere and mobility extraction.
variable        kx equal 2.0*PI/lx
variable        ky equal 2.0*PI/ly
variable        kz equal 2.0*PI/lz
variable        rho_kx_re atom q*cos(v_kx*x)
variable        rho_kx_im atom q*sin(v_kx*x)
variable        rho_ky_re atom q*cos(v_ky*y)
variable        rho_ky_im atom q*sin(v_ky*y)
variable        rho_kz_re atom q*cos(v_kz*z)
variable        rho_kz_im atom q*sin(v_kz*z)
compute         RHO_KX_RE all reduce sum v_rho_kx_re
compute         RHO_KX_IM all reduce sum v_rho_kx_im
compute         RHO_KY_RE all reduce sum v_rho_ky_re
compute         RHO_KY_IM all reduce sum v_rho_ky_im
compute         RHO_KZ_RE all reduce sum v_rho_kz_re
compute         RHO_KZ_IM all reduce sum v_rho_kz_im
group           RESPONSE_SPECIES_0 molecule 1:30
variable        p_0_x atom mass*vx
compute         P_0_X RESPONSE_SPECIES_0 reduce sum v_p_0_x
variable        p_0_y atom mass*vy
compute         P_0_Y RESPONSE_SPECIES_0 reduce sum v_p_0_y
variable        p_0_z atom mass*vz
compute         P_0_Z RESPONSE_SPECIES_0 reduce sum v_p_0_z
group           RESPONSE_SPECIES_1 molecule 31:86
variable        p_1_x atom mass*vx
compute         P_1_X RESPONSE_SPECIES_1 reduce sum v_p_1_x
variable        p_1_y atom mass*vy
compute         P_1_Y RESPONSE_SPECIES_1 reduce sum v_p_1_y
variable        p_1_z atom mass*vz
compute         P_1_Z RESPONSE_SPECIES_1 reduce sum v_p_1_z
group           RESPONSE_SPECIES_2 molecule 87:93
compute         J_2_X RESPONSE_SPECIES_2 reduce sum v_jx
compute         J_2_Y RESPONSE_SPECIES_2 reduce sum v_jy
compute         J_2_Z RESPONSE_SPECIES_2 reduce sum v_jz
group           RESPONSE_SPECIES_3 molecule 94:100
compute         J_3_X RESPONSE_SPECIES_3 reduce sum v_jx
compute         J_3_Y RESPONSE_SPECIES_3 reduce sum v_jy
compute         J_3_Z RESPONSE_SPECIES_3 reduce sum v_jz
fix             RESPONSE all ave/time 1 1 1 c_RHO_KX_RE c_RHO_KX_IM c_RHO_KY_RE c_RHO_KY_IM c_RHO_KZ_RE c_RHO_KZ_IM c_P_0_X c_P_0_Y c_P_0_Z c_P_1_X c_P_1_Y c_P_1_Z c_J_2_X c_J_2_Y c_J_2_Z c_J_3_X c_J_3_Y c_J_3_Z file response.dat format " %.10e"
compute         MOL_CHUNK all chunk/atom molecule nchunk once ids once
compute         MOL_COM all com/chunk MOL_CHUNK
compute         MOL_VCOM all vcm/chunk MOL_CHUNK
variable        MOLECULAR_FORCE_X atom fx
variable        MOLECULAR_FORCE_Y atom fy
variable        MOLECULAR_FORCE_Z atom fz
compute         MOL_FORCE all reduce/chunk MOL_CHUNK sum v_MOLECULAR_FORCE_X v_MOLECULAR_FORCE_Y v_MOLECULAR_FORCE_Z
fix             MOLECULAR_TRANSPORT all ave/time 10 1 10 c_MOL_COM[*] c_MOL_VCOM[*] c_MOL_FORCE[*] mode vector file molecular_transport.dat
dump            GEOMETRY all custom 1000 trajectory.lammpstrj id mol type q xu yu zu
dump_modify     GEOMETRY sort id

thermo_style    custom step time temp press vol density pe ke etotal
thermo          2000

run             500000

write_data      ec_dmc_3_7_libf4_1m_298K.prod.lmp
