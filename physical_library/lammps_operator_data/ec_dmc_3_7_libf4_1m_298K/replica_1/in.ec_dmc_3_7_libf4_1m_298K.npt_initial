# Initial NPT chunk for composition tag=ec_dmc_3_7_libf4_1m_298K
# Generated by scripts/curate_ff_md_data.py

units           real
boundary        p p p
atom_style      full
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  cvff

pair_style      lj/cut/coul/long 12.0 12.0
pair_modify     mix arithmetic
special_bonds   lj/coul 0.0 0.0 0.5

read_data       ec_dmc_3_7_libf4_1m_298K.lmp

# openff-interchange writes the box as triclinic with zero tilt; PPPM stalls
# indefinitely in triclinic mode on this brew LAMMPS build, but works fine
# after change_box all ortho converts the zero-tilt box to orthogonal.
change_box      all ortho
kspace_style    pppm 1.0e-4

min_style       cg
minimize        1.0e-4 1.0e-6 10000 100000
velocity        all create 298.15 104729 dist gaussian
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        1.0

thermo_style    custom step time temp press vol density pe ke etotal
thermo          100
variable        tracked_temperature_K equal temp
variable        tracked_density_g_cm3 equal density
variable        tracked_volume_A3 equal vol
variable        tracked_pressure_atm equal press
fix             NPT_EQ all npt temp 298.15 298.15 100.0 iso 1.0 1.0 1000.0
fix             NPT_TRACE all ave/time 100 1 100 v_tracked_temperature_K v_tracked_density_g_cm3 v_tracked_volume_A3 v_tracked_pressure_atm file ${thermo_trace}
run             5000
unfix           NPT_TRACE
unfix           NPT_EQ
write_restart   ${output_restart}
