# Restart continuation NPT chunk for composition tag=ec_dmc_3_7_liclo4_1m_298K
# Generated by scripts/curate_ff_md_data.py

read_restart    ${input_restart}
kspace_style    pppm 1.0e-4
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        1.0

thermo_style    custom step time temp press vol density pe ke etotal
thermo          100
variable        tracked_temperature_K equal temp
variable        tracked_density_g_cm3 equal density
variable        tracked_volume_A3 equal vol
variable        tracked_pressure_atm equal press
fix             NPT_EQ all npt temp 298.15 298.15 100.0 iso 1.0 1.0 1000.0
fix             NPT_TRACE all ave/time 100 1 100 v_tracked_temperature_K v_tracked_density_g_cm3 v_tracked_volume_A3 v_tracked_pressure_atm file ${thermo_trace}
run             5000
unfix           NPT_TRACE
unfix           NPT_EQ
write_restart   ${output_restart}
